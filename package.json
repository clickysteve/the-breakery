{
  "name": "the-breakery",
  "version": "0.1.0",
  "private": true,
  "description": "The Breakery: freshly baked breaks. A generative breakbeat instrument for the browser, from the Slop Factory.",
  "homepage": "https://breakery.allmyfriendsaresynths.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/clickysteve/the-breakery.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "evaluate": "BREAKERY_SCRIPTS=1 vitest run evaluate"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/tiny5": "^5.3.0",
    "@slopfactory/core": "github:clickysteve/slopfactory-core#fb403db63d21caa96d3ca816c799671c0be11707"
  }
}
